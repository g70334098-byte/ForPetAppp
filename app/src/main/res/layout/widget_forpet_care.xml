<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐾 발자국동행 안심 관제"
            android:textColor="#0284C7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DCFCE7"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🟢 LIVE GPS"
            android:textColor="#15803D"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 실시간 상태 메인 문구 -->
    <TextView
        android:id="@+id/widget_tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="초코 아이 안심 이송 중 🐶"
        android:textColor="#0F172A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 목적지 및 병원 안내 -->
    <TextView
        android:id="@+id/widget_tv_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="목적지: 명지24시온누리메디컬센터 (약 6분 후 도착)"
        android:textColor="#475569"
        android:textSize="11sp" />

    <!-- 하단 차량 및 업데이트 시간 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tv_vehicle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🚗 레이 케어카 (박찬헌 가드)"
            android:textColor="#0284C7"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="앱 열기 ➔"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
